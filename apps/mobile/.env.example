EXPO_PUBLIC_API_URL=http://localhost:3000

# ── Google sign-in ────────────────────────────────────────────────────
# Three OAuth clients from the same Google Cloud project
# (APIs & Services → Credentials → Create credentials → OAuth client ID):
#
#   Web client      → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
#                     Same value as GOOGLE_CLIENT_ID in apps/web/.env.
#   iOS client      → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
#                     Bundle ID: com.trs.therightspot
#   Android client  → EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID
#                     Package: com.trs.therightspot + the SHA-1 of your
#                     signing key (`eas credentials` or keytool on the
#                     debug keystore).
#
# The button only appears when the web ID *and* the ID for the platform
# you're running on are set. The iOS/Android IDs must also be listed in
# apps/web/.env (GOOGLE_IOS_CLIENT_ID / GOOGLE_ANDROID_CLIENT_ID) so the API
# accepts the tokens they issue.
#
# Native Google sign-in needs a development build (`npx expo run:ios`,
# `npx expo run:android`, or an EAS dev build) — it cannot work in Expo Go,
# whose exp:// redirect Google refuses.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
