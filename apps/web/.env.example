# ── Database ─────────────────────────────────────────────────────────
# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://trs:trs_local_pwd@localhost:5432/the_right_spot"

# ── Auth ─────────────────────────────────────────────────────────────
# Any long random strings locally; real secrets in deployed environments.
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# ── Object storage (Cloudflare R2) ───────────────────────────────────
# REQUIRED for photo upload. Without these, uploading a photo fails, and
# since every spot needs a photo you cannot create a spot at all.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL the bucket is served from, no trailing slash.
R2_PUBLIC_URL=""

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional ─────────────────────────────────────────────────────────
# Google sign-in. The button is hidden when this is unset.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
# The mobile app signs in through Google's native flow, whose ID tokens are
# issued to the iOS / Android OAuth clients rather than the Web one. List
# them here so the API accepts those tokens too (same values as the
# EXPO_PUBLIC_GOOGLE_*_CLIENT_ID vars in apps/mobile/.env).
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
# Transactional email (password reset).
RESEND_API_KEY=""
EMAIL_FROM=""
