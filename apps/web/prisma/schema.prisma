generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────

enum AuthProvider {
  EMAIL
  GOOGLE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  provider     AuthProvider @default(EMAIL)
  providerId   String?

  username  String  @unique
  name      String
  avatarUrl String?
  bio       String?
  locale    String  @default("fr")
  isPrivate Boolean @default(false)

  spots               Spot[]
  spotPhotos          SpotPhoto[]
  photoMentions       SpotPhotoMention[]
  spotLikes           SpotLike[]
  followers           Follow[]             @relation("following")
  following           Follow[]             @relation("follower")
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, providerId])
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  status      FollowStatus @default(PENDING)
  follower    User         @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User         @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  // As a notification for `following`: read when looked at (or marked so),
  // kept unread on purpose, or dismissed from the list altogether.
  readAt      DateTime?
  unreadKept  Boolean   @default(false)
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([followingId, status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─── Spots ───────────────────────────────────────────────────────────

enum CompositionType {
  SYMMETRY
  ASYMMETRY
  FRAME_IN_FRAME
  FIBONACCI
  RULE_OF_THIRDS
  LEADING_LINES
  DIAGONAL
  CENTERED
  MINIMALIST
  PATTERN
  OTHER
}

enum SpotVisibility {
  PRIVATE
  FOLLOWERS
}

/// From a short stroll on open ground to land you need permission for.
enum SpotAccessibility {
  EASY
  MODERATE
  HARD
  RESTRICTED
  PRIVATE
}

model Spot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Location
  latitude  Float
  longitude Float
  address   String?
  city      String?
  country   String?

  // Photo
  photoUrl String
  photoKey String // R2 object key for lifecycle management

  // Metadata
  title       String?
  description String?
  isFree      Boolean @default(true)
  priceInfo   String?

  // Visibility
  visibility        SpotVisibility @default(FOLLOWERS)
  customComposition String?

  // How hard the spot is to reach — unknown until the photographer says
  accessibility SpotAccessibility?

  // Photography attributes — PostgreSQL native arrays
  colors       String[] // hex values e.g. ["#D4A574", "#2E4A3E"]
  compositions CompositionType[]
  tags         String[]

  spotPhotos SpotPhoto[]
  images     SpotImage[]
  likes      SpotLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([latitude, longitude])
  // The map always filters by owner(s) then box — one index walks both
  @@index([userId, latitude, longitude])
  @@index([createdAt(sort: Desc)])
}

model SpotImage {
  id       String @id @default(cuid())
  spotId   String
  spot     Spot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  photoUrl String
  photoKey String
  order    Int    @default(0)

  @@index([spotId, order])
}

// ─── Likes ───────────────────────────────────────────────────────────

/// A saved spot. Also the owner's "someone liked your spot" notification,
/// with the same read / kept-unread / dismissed state as a Follow.
model SpotLike {
  id     String @id @default(cuid())
  spotId String
  spot   Spot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt      DateTime?
  unreadKept  Boolean   @default(false)
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([spotId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

// ─── Community Photos ───────────────────────────────────────────────

/// A photographer's post under a spot: what they wrote, who they named,
/// and the photos they brought — one or several.
model SpotPhoto {
  id     String @id @default(cuid())
  spotId String
  spot   Spot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  caption String?

  images   SpotPhotoImage[]
  mentions SpotPhotoMention[]

  createdAt DateTime @default(now())

  @@index([spotId, createdAt(sort: Desc)])
  @@index([userId])
}

/// One photo of a post, in the order it was chosen.
model SpotPhotoImage {
  id      String    @id @default(cuid())
  photoId String
  photo   SpotPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  photoUrl String
  photoKey String // R2 object key
  position Int    @default(0)

  @@index([photoId, position])
}

/// Someone named with an @ in a post, resolved to the account they meant.
model SpotPhotoMention {
  id      String    @id @default(cuid())
  photoId String
  photo   SpotPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId])
  @@index([userId])
}
