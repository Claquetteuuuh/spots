generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────

enum AuthProvider {
  EMAIL
  GOOGLE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  provider     AuthProvider @default(EMAIL)
  providerId   String?

  username  String  @unique
  name      String
  avatarUrl String?
  bio       String?
  locale    String  @default("fr")

  spots              Spot[]
  spotPhotos         SpotPhoto[]
  followers          Follow[]             @relation("following")
  following          Follow[]             @relation("follower")
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, providerId])
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  status      FollowStatus @default(PENDING)
  follower    User         @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User         @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([followingId, status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─── Spots ───────────────────────────────────────────────────────────

enum CompositionType {
  SYMMETRY
  ASYMMETRY
  FRAME_IN_FRAME
  FIBONACCI
  RULE_OF_THIRDS
  LEADING_LINES
  DIAGONAL
  CENTERED
  MINIMALIST
  PATTERN
  OTHER
}

enum SpotVisibility {
  PRIVATE
  FOLLOWERS
}

model Spot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Location
  latitude  Float
  longitude Float
  address   String?
  city      String?
  country   String?

  // Photo
  photoUrl String
  photoKey String // R2 object key for lifecycle management

  // Metadata
  title       String?
  description String?
  isFree      Boolean @default(true)
  priceInfo   String?

  // Visibility
  visibility        SpotVisibility @default(FOLLOWERS)
  customComposition String?

  // Photography attributes — PostgreSQL native arrays
  colors       String[]          // hex values e.g. ["#D4A574", "#2E4A3E"]
  compositions CompositionType[]
  tags         String[]

  spotPhotos SpotPhoto[]
  images     SpotImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([latitude, longitude])
  @@index([createdAt(sort: Desc)])
}

model SpotImage {
  id       String @id @default(cuid())
  spotId   String
  spot     Spot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  photoUrl String
  photoKey String
  order    Int    @default(0)

  @@index([spotId, order])
}

// ─── Community Photos ───────────────────────────────────────────────

model SpotPhoto {
  id      String @id @default(cuid())
  spotId  String
  spot    Spot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  photoUrl String
  photoKey String // R2 object key
  caption  String?

  createdAt DateTime @default(now())

  @@index([spotId, createdAt(sort: Desc)])
  @@index([userId])
}
